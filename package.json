{
  "name": "office-line-notifier",
  "version": "1.0.0",
  "description": "學校辦公室 LINE 行政通知、教師身分綁定與雙向訊息系統",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "pages:prepare": "node scripts/build-site.mjs mock",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "dev:api": "wrangler dev --config wrangler.worker.jsonc --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply office-line-notifier --local",
    "setup:local": "node scripts/setup-local.mjs",
    "build:cloudflare": "node scripts/build-site.mjs cloudflare",
    "preview:cloudflare": "wrangler pages dev dist --port 8788 --binding ALLOWED_ORIGIN=http://localhost:8788 --binding COOKIE_SECURE=false --binding LINE_SEND_ENABLED=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.160.1"
  }
}
